{
  "name": "@fluidkit/svelte",
  "version": "2.0.0",
  "description": "Fluid Kit for Svelte: Liquid Blur's glass, morph, indicator, drag, lift and layout as components and runes, on interruptible springs that keep their speed.",
  "keywords": [
    "animation",
    "drag",
    "fluidkit",
    "gesture",
    "glass",
    "ios",
    "layout",
    "liquid-glass",
    "morph",
    "spring",
    "svelte",
    "transitions"
  ],
  "homepage": "https://fluidkit.mogilnikov.dev",
  "bugs": {
    "url": "https://github.com/mikhailmogilnikov/fluid-kit/issues"
  },
  "license": "MIT",
  "author": "Mikhail Mogilnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailmogilnikov/fluid-kit.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "fk-svelte-package -i src -o dist --tsconfig tsconfig.svelte.json && cp ../core/dist/style.css dist/style.css",
    "check-types": "tsc --noEmit && fk-svelte-check --tsconfig tsconfig.svelte.json",
    "test": "vp test run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@fluidkit/core": "workspace:*"
  },
  "devDependencies": {
    "@fluidkit/svelte-tools": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "happy-dom": "^21.0.4",
    "svelte": "5.57.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  },
  "peerDependencies": {
    "svelte": ">=5.29"
  }
}
