{
  "name": "@fluidkit/vue",
  "version": "1.6.0",
  "description": "Fluid Kit for Vue: Liquid Blur's glass, morph, indicator, drag, lift and layout as components and composables, on interruptible springs that keep their speed.",
  "keywords": [
    "animation",
    "drag",
    "fluidkit",
    "gesture",
    "glass",
    "ios",
    "layout",
    "liquid-glass",
    "morph",
    "spring",
    "transitions",
    "vue"
  ],
  "homepage": "https://fluidkit.mogilnikov.dev",
  "bugs": {
    "url": "https://github.com/mikhailmogilnikov/fluid-kit/issues"
  },
  "license": "MIT",
  "author": "Mikhail Mogilnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailmogilnikov/fluid-kit.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && cp ../core/dist/style.css dist/style.css",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@fluidkit/core": "workspace:*"
  },
  "devDependencies": {
    "@vue/test-utils": "2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0",
    "vue": "3.5.44"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  }
}
