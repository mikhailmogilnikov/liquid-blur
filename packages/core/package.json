{
  "name": "@fluidkit/core",
  "version": "2.0.0",
  "description": "Fluid Kit without a framework: Liquid Blur's glass, morph, indicator, drag, lift and layout on interruptible springs that keep their speed, and Apple's springs and transitions for CSS.",
  "keywords": [
    "animation",
    "drag",
    "fluidkit",
    "gesture",
    "glass",
    "ios",
    "layout",
    "liquid-glass",
    "morph",
    "spring",
    "transitions"
  ],
  "homepage": "https://fluidkit.mogilnikov.dev/core",
  "bugs": {
    "url": "https://github.com/mikhailmogilnikov/fluid-kit/issues"
  },
  "license": "MIT",
  "author": "Mikhail Mogilnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailmogilnikov/fluid-kit.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/auto.js"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./style.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/style.css"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "gen:motion": "FK_WRITE_MOTION=1 vp test run test/base/motion.test.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check-types && pnpm test"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  }
}
