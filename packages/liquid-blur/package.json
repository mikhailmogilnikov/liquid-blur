{
  "name": "liquid-blur",
  "version": "1.0.0",
  "description": "A glass material for the web: backdrop blur, fill, rims and springy press behaviors. No refraction.",
  "type": "module",
  "author": "Mikhail Mogilnikov",
  "license": "MIT",
  "homepage": "https://github.com/mikhailmogilnikov/liquid-blur#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailmogilnikov/liquid-blur.git",
    "directory": "packages/liquid-blur"
  },
  "bugs": {
    "url": "https://github.com/mikhailmogilnikov/liquid-blur/issues"
  },
  "keywords": [
    "css",
    "glass",
    "liquid-glass",
    "blur",
    "backdrop-filter",
    "material"
  ],
  "sideEffects": [
    "*.css",
    "./dist/auto.js"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./group": {
      "types": "./dist/group.d.ts",
      "default": "./dist/group.js"
    },
    "./morph": {
      "types": "./dist/morph.d.ts",
      "default": "./dist/morph.js"
    },
    "./liquid-blur.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/liquid-blur.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && esbuild src/liquid-blur.css --minify --log-level=warning --outfile=dist/liquid-blur.css",
    "dev": "tsup --watch --onSuccess \"tsc -p tsconfig.build.json && esbuild src/liquid-blur.css --minify --log-level=warning --outfile=dist/liquid-blur.css\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check-types && pnpm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
