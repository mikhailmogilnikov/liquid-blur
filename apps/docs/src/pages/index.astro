---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Stage from "../components/Stage.astro";
import GroupDock from "../components/GroupDock.astro";
import MorphPreview from "../components/MorphPreview.astro";
import IndicatorExample from "../components/IndicatorExample.astro";
import DragExample from "../components/DragExample.astro";
import EdgeExample from "../components/EdgeExample.astro";
import LiftExample from "../components/LiftExample.astro";
import LayoutExample from "../components/LayoutExample.astro";
import MotionExample from "../components/MotionExample.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import Hint from "../components/Hint.astro";

const REPO = "https://github.com/mikhailmogilnikov/fluid-kit";
---

<Base
  title="Fluid Kit — fluid interfaces for the web"
  description="Small, framework-agnostic libraries for fluid interfaces: a glass material, a control that becomes a panel, a highlight that follows the pointer, and things you drag and flick."
>
  <Nav current="home" />

  <main>
    <section class="hero">
      <div class="mark mark--hero"><span class="lb"></span></div>
      <p class="lead rise" style="--i: 1">
        <b>Fluid Kit</b> is a family of libraries for fluid interfaces: a glass material in plain CSS,
        buttons that grow into panels, highlights that follow the pointer, and sheets you can flick.
        Works with vanilla TypeScript, React, Vue or Svelte.
      </p>
      <div class="actions rise" style="--i: 2">
        <a class="button button--ink breathe" href="/blur">Get started</a>
        <a class="button button--wash" href={REPO}><Icon name="github" size={18} />GitHub</a>
      </div>
    </section>

    <section class="block showcase" aria-label="Demos and libraries">
      <div class="reveal">
        <Stage />
      </div>

      <div class="libs">
        <article class="lib reveal">
          <div class="lib__scene" data-hints>
            <div class="bd bd-aurora"></div>
            <GroupDock />
            <Hint text="try to drag" light style="top: calc(50% + 34px); left: calc(50% - 31px)" />
          </div>
          <div class="lib__body">
            <a class="lib__head" href="/blur">
              <b>Liquid Blur</b><code>.lb</code><Icon name="arrow" size={16} />
            </a>
            <p>A glass material in plain CSS, with press effects and glass that merges together.</p>
          </div>
        </article>

        <article class="lib reveal" style="--d: 80ms">
          <MorphPreview>
            <Hint text="tap to switch" light style="top: calc(50% + 30px); left: 50%" />
          </MorphPreview>
          <div class="lib__body">
            <a class="lib__head" href="/morph">
              <b>Morph</b><code>createMorph</code><Icon name="arrow" size={16} />
            </a>
            <p>Animate one element into another and back, on springs you can reverse mid-way.</p>
          </div>
        </article>

        <article class="lib reveal" style="--d: 160ms">
          <IndicatorExample kind="menu" card />
          <div class="lib__body">
            <a class="lib__head" href="/indicator">
              <b>Indicator</b><code>createIndicator</code><Icon name="arrow" size={16} />
            </a>
            <p>One element that moves to whatever is hovered, pressed or selected: menus, tabs, segmented controls.</p>
          </div>
        </article>

        <article class="lib reveal" style="--d: 240ms">
          <DragExample kind="pip" card>
            <Hint text="throw it" light style="top: 124px; left: 96px" />
          </DragExample>
          <div class="lib__body">
            <a class="lib__head" href="/drag">
              <b>Drag</b><code>createDrag</code><Icon name="arrow" size={16} />
            </a>
            <p>Drag with rubber-band edges and snap points that respect the flick: sheets, swipes, switches.</p>
          </div>
        </article>

        <article class="lib reveal" style="--d: 320ms">
          <LiftExample kind="photos" card>
            <Hint text="hold it" light style="bottom: 30px; left: 50%" />
          </LiftExample>
          <div class="lib__body">
            <a class="lib__head" href="/lift">
              <b>Lift</b><code>createLift</code><Icon name="arrow" size={16} />
            </a>
            <p>Long-press anything to lift it above a blurred page and open your menu next to it.</p>
          </div>
        </article>

        <article class="lib reveal" style="--d: 400ms">
          <LayoutExample kind="list" card>
            <Hint text="tap them" light style="top: 274px; left: max(calc(50% - 137px), 49px)" />
          </LayoutExample>
          <div class="lib__body">
            <a class="lib__head" href="/layout">
              <b>Layout</b><code>createLayout</code><Icon name="arrow" size={16} />
            </a>
            <p>Change the page and its elements move to their new places on springs: lists, grids, sections.</p>
          </div>
        </article>

        <article class="lib reveal" style="--d: 480ms">
          <EdgeExample card>
            <Hint text="scroll it" light style="bottom: 30px; left: 50%" />
          </EdgeExample>
          <div class="lib__body">
            <a class="lib__head" href="/edge">
              <b>Scroll Edge</b><code>.lb-edge</code><Icon name="arrow" size={16} />
            </a>
            <p>Scrolling content fades out at its edges, like under iOS bars, only where there's more to scroll.</p>
          </div>
        </article>

        <article class="lib reveal" style="--d: 560ms">
          <MotionExample card />
          <div class="lib__body">
            <a class="lib__head" href="/motion">
              <b>Motion</b><code>springs</code><Icon name="arrow" size={16} />
            </a>
            <p>Apple's springs and transitions by name, for the packages and for CSS, ready to tune.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="end">
      <div class="mark mark--hero mark--on-reveal" style="--s: 3"><span class="lb"></span></div>
      <p class="lead reveal"><b>Make your interface fluid.</b> Free and open source, MIT.</p>
      <div class="actions reveal">
        <a class="button button--ink breathe" href="/blur">Read the docs</a>
        <a class="button button--wash" href={REPO}><Icon name="github" size={18} />GitHub</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
