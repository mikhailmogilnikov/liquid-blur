---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Icon from "../components/Icon.astro";
import Footer from "../components/Footer.astro";
import GroupDock from "../components/GroupDock.astro";


const toc = [
  ["start", "Get started"],
  ["modules", "Modules"],
  ["classes", "Classes"],
  ["customize", "Customize"],
  ["colors", "Colors"],
  ["theming", "Theming"],
  ["tailwind", "Tailwind & layers"],
  ["accessibility", "Accessibility"],
  ["behaviors", "Press behaviors"],
  ["groups", "Glass groups"],
  ["morph", "Morph"],
  ["api", "API"],
  ["support", "Browser support"],
  ["limitations", "Limitations"],
  ["faq", "FAQ"],
];

const classes = [
  {
    name: "lb",
    text: "The material. Backdrop blur, a fill, volume, rims, an edge and a shadow. Required.",
    sample: "lb",
    bd: "bd-aurora",
  },
  {
    name: "lb-clear",
    text: "At least transparency 1. For glass over photos and video, where the content is the point.",
    sample: "lb lb-clear",
    bd: "bd-stripes",
  },
  {
    name: "lb-tinted",
    text: "The fill is --lb-tint and the text is --lb-tint-text. Volume and rims stay.",
    sample: "lb lb-tinted",
    bd: "bd-aurora",
  },
  {
    name: "lb-highlight",
    text: "Lights up where it's pressed and follows the finger. Press it.",
    sample: "lb lb-highlight",
    bd: "bd-dots",
  },
  {
    name: "lb-swell",
    text: "Grows while pressed, on a spring that can turn around mid-flight. Small glass grows more, big glass barely.",
    sample: "lb lb-swell lb-highlight",
    bd: "bd-aurora",
  },
  {
    name: "lb-stretch",
    text: "Pulls toward the finger and stretches along the drag. Small glass is lively, big glass is heavy. Drag it.",
    sample: "lb lb-stretch lb-highlight",
    bd: "bd-stripes",
  },
  {
    name: "lb-interactive",
    text: "All three at once, the usual set for a button, chip or icon. Press it, drag it.",
    sample: "lb lb-interactive",
    bd: "bd-aurora",
  },
];

const vars = [
  {
    group: "Material",
    items: [
      ["--lb-transparency", "0.5", "0 is opaque, 1 is clear. Moves fill and blur together."],
      ["--lb-depth", "0.5", "0 is flat, 1 is pronounced. Moves shading, glow and rims."],
      ["--lb-dark", "per theme", "0 is light, 1 is dark. Follows the system and data-theme."],
    ],
  },
  {
    group: "Color",
    items: [
      ["--lb-fill-light", "#ffffff", "Fill in the light theme."],
      ["--lb-fill-dark", "#3a3a3a", "Fill in the dark theme."],
      ["--lb-fill", "unset", "One fill for both themes; wins over the two above."],
      ["--lb-text-light", "#000000", "Text in the light theme."],
      ["--lb-text-dark", "#ffffff", "Text in the dark theme."],
      ["--lb-text", "unset", "One text color for both themes."],
      ["--lb-tint", "#007aff", "Color of lb-tinted glass."],
      ["--lb-tint-text", "#ffffff", "Text on lb-tinted glass."],
      ["--lb-shade-color", "#000000", "The dark parts: volume shading, edge, drop shadow."],
      ["--lb-shine-color", "#ffffff", "The light parts: rims, glow, press highlight."],
    ],
  },
  {
    group: "Behavior",
    items: [
      ["--lb-highlight-size", "1", "Reach of the press highlight, as a multiplier. It already follows the element's size."],
      ["--lb-swell", "1.1", "Pressed scale at button size. Smaller glass grows more, bigger less."],
      ["--lb-stretch", "2", "Stretch strength; 0 turns it off."],
    ],
  },
];

const a11y = [
  ["eye", "Reduced transparency", "With the system setting on, glass turns opaque and the backdrop filter goes away."],
  ["contrast", "Increased contrast", "Opaque glass with a stronger edge, so every control keeps its outline."],
  ["frame", "Forced colors", "Windows High Contrast drops backgrounds and shadows; an outline takes their place, one around a melted group."],
  ["motion", "Reduced motion", "No swell, no stretch; morphs switch immediately. Presses still light up."],
  ["keyboard", "Keyboard", "Enter and Space on a focused glass press it, until that same key comes up."],
  ["layers", "Solid material", 'data-lb-material="solid" on any ancestor makes all glass inside it opaque.'],
] as const;

const code = {
  css: `import "@liquid-web/blur/style.css";`,
  html: `<button class="lb">Glass</button>`,
  script: `import { installPress } from "@liquid-web/blur/press";

installPress();`,
  cdn: `<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@liquid-web/blur@1/dist/style.css" />
<!-- /+esm resolves its import of @liquid-web/core -->
<script type="module" src="https://cdn.jsdelivr.net/npm/@liquid-web/blur@1/dist/auto.js/+esm"></script>`,
  customize: `.toolbar {
  --lb-transparency: 0.8;
  --lb-depth: 0.3;
}

.danger {
  --lb-tint: #ff3b30;
}`,
  colors: `/* Your own neutral, per theme */
:root {
  --lb-fill-light: #f5f5f7;
  --lb-fill-dark: #1c1c1e;
}

/* Warm glass: fill, shading and rims all lean amber */
.warm {
  --lb-fill-light: #ffe08a;
  --lb-shade-color: #5a2a00;
  --lb-shine-color: #fff4c0;
}

/* A light tint needs dark text */
.warning {
  --lb-tint: #ffcc00;
  --lb-tint-text: #111;
}`,
  theming: `<html data-theme="dark">
  <section data-theme="light">
    <button class="lb">Always light</button>
  </section>
</html>`,
  themeSwitch: `/* Tailwind, shadcn, next-themes with attribute="class" */
.dark { --lb-dark: 1; }

/* daisyUI and other named themes */
[data-theme="dracula"] { --lb-dark: 1; }`,
  tailwind: `@layer liquid-blur, theme, base, components, utilities;
@import "tailwindcss";
@import "@liquid-web/blur/style.css";`,
  install: `const uninstall = installPress();

// An iframe has its own document
installPress(frame.contentDocument);

// Later, if the page goes away
uninstall();`,
  spring: `import { SpringAnimator } from "@liquid-web/core";

const spring = new SpringAnimator(
  { width: 100, radius: 12 },
  { duration: 0.4, bounce: 0.2 },
  ({ width, radius }) => {
    el.style.width = \`\${width}px\`;
    el.style.borderRadius = \`\${radius}px\`;
  },
);

spring.to({ width: 240, radius: 24 });`,
  channels: `new SpringAnimator(
  { opacity: 0, scale: 1 },
  {
    opacity: { duration: 0.15, bounce: 0 },
    scale: { duration: 0.45, bounce: 0.3 },
  },
  ({ opacity, scale }) => { /* … */ },
);`,
  group: `<div class="lb-group">
  <div class="lb">…</div>
  <button class="lb lb-interactive">…</button>
</div>

<script type="module">
  import { installGlassGroups } from "@liquid-web/blur/melt";

  installGlassGroups();
</script>`,
  groupManual: `import { createGlassGroup } from "@liquid-web/blur/melt";

const group = createGlassGroup(toolbar);

// A child moved by something the group can't see
group.update();

// Later
group.destroy();`,
  groupReact: `import { useEffect } from "react";
import { installGlassGroups } from "@liquid-web/blur/melt";

export function Toolbar() {
  // After hydration: the group adds its own elements to the root
  useEffect(() => installGlassGroups(), []);
  return (
    // "lb" in the markup too, so a re-render keeps it
    <div className="lb lb-group">
      <div className="lb">…</div>
      <button className="lb lb-interactive">…</button>
    </div>
  );
}`,
  morphLayout: `<div class="morph-scene">
  <button id="more" class="lb" type="button" aria-controls="panel">More</button>
  <div id="panel">
    <p>Panel content</p>
    <button id="close-panel" type="button">Close</button>
  </div>
</div>

<style>
  .morph-scene { position: relative; min-height: 240px; }
  #more { width: 88px; height: 44px; border-radius: 22px; }
  #panel {
    position: absolute;
    left: 0;
    top: 0;
    width: min(280px, 100%);
    height: 220px;
    box-sizing: border-box;
    padding: 20px;
    border-radius: 28px;
    visibility: hidden;
    z-index: 2;
  }
</style>`,
  morph: `import "@liquid-web/blur/style.css";
import { createMorph } from "@liquid-web/morph";

// After mounting or hydration
const source = document.getElementById("more")!;
const content = document.getElementById("panel")!;
const close = document.getElementById("close-panel")!;

const morph = createMorph({
  source,
  content,
  // Escape and a press outside close it
  dismiss: true,
  // Into the panel as it sets off; back to the control once it's there again
  onStart(open) {
    if (open) close.focus({ preventScroll: true });
  },
  onRest(open) {
    if (!open && content.contains(document.activeElement)) source.focus({ preventScroll: true });
  },
});

const toggle = () => morph.toggle();
const dismiss = () => morph.close();
source.addEventListener("click", toggle);
close.addEventListener("click", dismiss);

// On unmount:
// source.removeEventListener("click", toggle);
// close.removeEventListener("click", dismiss);
// morph.destroy();`,
  morphReact: `import { useEffect, useRef, useState } from "react";
import { createMorph, type Morph, type MorphOptions } from "@liquid-web/morph";

/** Options are read once, on mount */
export function useMorph(options: Omit<MorphOptions, "source" | "content"> = {}) {
  const source = useRef<HTMLButtonElement>(null);
  const content = useRef<HTMLDivElement>(null);
  const morph = useRef<Morph | null>(null);
  const [open, setOpen] = useState(options.initialOpen ?? false);
  useEffect(() => {
    const m = createMorph({
      ...options,
      source: source.current!,
      content: content.current!,
      onStart(next) {
        setOpen(next);
        options.onStart?.(next);
      },
    });
    morph.current = m;
    return () => m.destroy();
  }, []);
  return {
    source,
    content,
    open,
    toggle: () => morph.current?.toggle(),
    close: () => morph.current?.close(),
  };
}

export function More() {
  const morph = useMorph({ dismiss: true });
  return (
    <div className="morph-scene">
      <button ref={morph.source} className="lb" type="button" aria-controls="panel" onClick={morph.toggle}>
        More
      </button>
      <div ref={morph.content} id="panel" role="menu">
        <button type="button" onClick={morph.close}>Close</button>
      </div>
    </div>
  );
}`,
  react: `import { useEffect } from "react";
import { installPress } from "@liquid-web/blur/press";

export function App() {
  useEffect(() => installPress(), []);
  return <button className="lb lb-highlight">Glass</button>;
}`,
};
---

<Base
  title="Docs — Liquid Blur"
  description="How to install, style, theme and animate Liquid Blur: classes, variables, accessibility and the API."
>
  <Nav current="docs" />

  <main>
    <section class="docs-head">
      <p class="lead rise" style="--i: 0">
        <b>Documentation.</b> Install it, put a class on something, then tune it — every class, variable
        and export, with live glass along the way. Want to play first?
        Try the <a href="/#playground">playground</a>.
      </p>
    </section>

    <div class="docs">
      <aside class="toc" aria-label="On this page">
        <span class="toc__title">On this page</span>
        {toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </aside>

      <div>
        <section class="doc" id="start">
          <p class="lead reveal">
            <a class="anchor" href="#start"><b>Three lines to glass.</b></a> Install the package, import the
            stylesheet once, and put <code>lb</code> on anything.
          </p>
          <ol class="steps">
            <li class="step reveal">
              <div>
                <p><b>Install.</b></p>
                <div class="code" data-install>
                  <div class="code__bar">
                    <div class="seg" role="group" aria-label="Package manager">
                      <span class="seg__thumb" aria-hidden="true"></span>
                      <button type="button" data-value="pnpm" aria-pressed="true">pnpm</button>
                      <button type="button" data-value="npm" aria-pressed="false">npm</button>
                      <button type="button" data-value="yarn" aria-pressed="false">yarn</button>
                      <button type="button" data-value="bun" aria-pressed="false">bun</button>
                    </div>
                  </div>
                  <pre><code><span class="tk-cmd">pnpm</span> add @liquid-web/blur</code></pre>
                  <button class="code__copy" type="button" data-copy aria-label="Copy command">
                    <Icon name="copy" class="is-idle" />
                    <Icon name="check" class="is-done" />
                  </button>
                </div>
              </div>
            </li>
            <li class="step reveal">
              <div>
                <p><b>Import the stylesheet</b>, once, anywhere in your app.</p>
                <CodeBlock code={code.css} lang="ts" />
              </div>
            </li>
            <li class="step reveal">
              <div>
                <p><b>Add the class.</b> That's the whole material.</p>
                <CodeBlock code={code.html} lang="html" />
              </div>
            </li>
            <li class="step reveal">
              <div>
                <p>
                  <b>Install press</b> if you use press behaviors. One delegated listener covers the whole
                  document, so elements mounted later just work — in React, Vue, Svelte, Astro or plain HTML.
                </p>
                <CodeBlock code={code.script} lang="ts" />
              </div>
            </li>
          </ol>
          <p class="prose reveal">
            No build step? Link the stylesheet and load the <code>auto</code> entry, which installs itself.
          </p>
          <div class="reveal"><CodeBlock code={code.cdn} lang="html" /></div>
        </section>

        <section class="doc" id="modules">
          <p class="lead reveal">
            <a class="anchor" href="#modules"><b>A family of packages.</b></a> <code>@liquid-web/blur</code> is
            the material, plain CSS, with press and melt in entries of their own. <code>@liquid-web/morph</code> is
            a package of its own, and <code>@liquid-web/core</code> is what they share. Each loads only when
            imported and works without the others.
          </p>
          <div class="rows reveal">
            <div class="row">
              <p>
                <b>Press <code>@liquid-web/blur/press</code></b>
                Highlight, swell and stretch on springs. The light is drawn by the material; swell and stretch
                move any element.
              </p>
              <p>
                <b>Melt <code>@liquid-web/blur/melt</code></b>
                Glass that melts between shapes when they come close. It draws the material itself, so it needs
                the stylesheet.
              </p>
            </div>
            <div class="row">
              <p>
                <b>Morph <code>@liquid-web/morph</code></b>
                A control grows into a panel and shrinks back. It copies whatever the control looks like: glass
                or not, it needs neither the material nor another module.
              </p>
              <p>
                <b>Spring <code>@liquid-web/core</code></b>
                The interruptible, velocity-keeping spring the others run on, for animations of your own.
              </p>
            </div>
          </div>
          <p class="prose reveal">
            None of them imports another. Where two meet, they read what the other marks in the DOM:
            a running group marks its root <code>data-lw-surface</code>, so a morph from one of its children
            lifts over or melts with the rest; elements a package creates carry <code>data-lw-part</code>, which
            press leaves alone; a morph's control is <code>data-lw-away</code> while its panel is out, and the
            group leaves it out.
          </p>
        </section>

        <section class="doc" id="classes">
          <p class="lead reveal">
            <a class="anchor" href="#classes"><b>Seven classes.</b></a> One for the material, two for its
            character, three for how it answers a touch, and one for all three. They combine freely.
          </p>
          <div class="rows">
            {
              classes.map((c) => (
                <div class="row reveal">
                  <p>
                    <b>
                      <code>{c.name}</code>
                    </b>
                    {c.text}
                  </p>
                  <div class="tile">
                    <div class={`bd ${c.bd}`} />
                    <button class={c.sample} type="button">
                      {c.name}
                    </button>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="prose reveal">
            Shape is plain <code>border-radius</code>; the default is a capsule. Press behaviors are for single
            controls, not containers.
          </p>
        </section>

        <section class="doc" id="customize">
          <p class="lead reveal">
            <a class="anchor" href="#customize"><b>One knob per idea.</b></a> Every variable is inherited, like a
            SwiftUI environment value: set it on any ancestor, and all glass inside picks it up.
          </p>
          <div class="vars reveal">
            {
              vars.map((g) => (
                <>
                  <div class="vars__group">{g.group}</div>
                  {g.items.map(([name, value, what]) => (
                    <div class="var">
                      <code>{name}</code>
                      <span class="var__default">
                        {value.startsWith("#") && <span class="dot" style={`--c: ${value}`} />}
                        <code>{value}</code>
                      </span>
                      <span class="var__what">{what}</span>
                    </div>
                  ))}
                </>
              ))
            }
          </div>
          <div class="reveal" style="margin-top: 28px"><CodeBlock code={code.customize} lang="css" /></div>
          <p class="prose reveal">
            Everything prefixed <code>--_</code> is internal calibration and may change without notice.
          </p>
        </section>

        <section class="doc" id="colors">
          <p class="lead reveal">
            <a class="anchor" href="#colors"><b>Your colors, our physics.</b></a> Colors resolve on the glass
            itself, so they follow the theme in effect — even on a subtree. You set the color; the material
            still decides how much of it shows.
          </p>
          <div class="reveal"><CodeBlock code={code.colors} lang="css" /></div>
          <p class="prose reveal">
            The glass sets its own text color for contrast with its fill. A <code>color</code> on the element
            still wins, as does <code>--lb-text</code>.
          </p>
        </section>

        <section class="doc" id="theming">
          <p class="lead reveal">
            <a class="anchor" href="#theming"><b>Light, dark, and yours.</b></a> The theme is one inherited
            number, <code>--lb-dark</code>. It follows the system by default, and
            <code>data-theme</code> on any element switches its subtree.
          </p>
          <div class="reveal"><CodeBlock code={code.theming} lang="html" /></div>
          <p class="prose reveal">Any other theme switch plugs in with a single line:</p>
          <div class="reveal"><CodeBlock code={code.themeSwitch} lang="css" /></div>
        </section>

        <section class="doc" id="tailwind">
          <p class="lead reveal">
            <a class="anchor" href="#tailwind"><b>Plays well with Tailwind.</b></a> All styles live in
            <code>@layer liquid-blur</code>, so any unlayered rule of yours wins without
            <code>!important</code>. Between layers the first one declared loses — declare ours first, and
            utilities like <code>rounded-xl</code> win.
          </p>
          <div class="reveal"><CodeBlock code={code.tailwind} lang="css" /></div>
        </section>

        <section class="doc" id="accessibility">
          <p class="lead reveal">
            <a class="anchor" href="#accessibility"><b>Glass that steps aside.</b></a> Transparency is a choice,
            not a requirement. Every system setting that asks for less of it is honored without a line of your
            code.
          </p>
          <ul class="grid grid--doc">
            {
              a11y.map(([icon, title, text], i) => (
                <li class="reveal" style={`--d: ${(i % 2) * 80}ms`}>
                  <Icon name={icon} size={24} />
                  <p>
                    <b>{title}.</b> {text}
                  </p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="doc" id="behaviors">
          <p class="lead reveal">
            <a class="anchor" href="#behaviors"><b>Made for fingers.</b></a> Presses feel like iOS, on any
            device.
          </p>
          <div class="rows reveal">
            <div class="row">
              <p>
                <b>Pressed state</b>
                While a pointer is down the element gets <code>data-lb-pressed</code>, which you can style
                too. On touch it waits a beat, so a finger landing to scroll doesn't flash it.
              </p>
              <p>
                <b>Springs, not transitions</b>
                Highlight and swell run on interruptible springs and clean up after themselves. Small glass
                swells more and bouncier, big glass barely. Your own
                <code>transition</code> stays yours; the swell multiplies your <code>scale</code>.
              </p>
            </div>
            <div class="row">
              <p>
                <b>Stretch</b>
                Like the swell, it has mass: the bigger the glass, the less it gives and bounces. Writes only
                <code>transform</code>, once a frame, with no layout reads, and restores yours when it settles.
              </p>
              <p>
                <b>Release outside</b>
                Let go more than 32px outside the element and the click is cancelled, as on iOS.
              </p>
            </div>
          </div>
        </section>

        <section class="doc" id="groups">
          <p class="lead reveal">
            <a class="anchor" href="#groups"><b>Glass that melts.</b></a> Pieces of one group share a single
            surface that flows between them when they come close, like drops of liquid. One backdrop, clipped
            to the merged outline, so nothing blurs twice. More in the <a href="/lab">lab</a>.
          </p>
          <div class="rows">
            <div class="row reveal">
              <p>
                <b>Split and dock</b>
                Press the search button. It moves with a plain CSS <code>transition</code>, and the glass
                follows it out and back, neck and all.
              </p>
              <div class="tile tile--group">
                <div class="bd bd-aurora"></div>
                <GroupDock />
              </div>
            </div>
            <div class="row reveal">
              <p>
                <b>Pull it</b>
                Press and drag any piece. Stretch and swell bend the outline between them as they go.
              </p>
              <div class="tile tile--group">
                <div class="bd bd-stripes"></div>
                <div class="lb lb-group demo-group">
                  <button class="lb lb-highlight lb-stretch demo-pill" type="button">Library</button>
                  <button class="lb lb-interactive round" type="button" aria-label="Add">
                    <Icon name="plus" size={20} />
                  </button>
                  <button class="lb lb-interactive round" type="button" aria-label="More">
                    <Icon name="more" size={20} />
                  </button>
                </div>
              </div>
            </div>
            <div class="row reveal">
              <p>
                <b>Drops</b>
                A CSS <code>@keyframes</code> animation, nothing else: the drop pulls away from the pill and
                falls back in. With reduced motion it stays put.
              </p>
              <div class="tile tile--group">
                <div class="bd bd-aurora"></div>
                <div class="lb lb-group demo-group">
                  <div class="lb demo-pill">Liquid Blur</div>
                  <div class="lb demo-drop"></div>
                </div>
              </div>
            </div>
          </div>
          <div class="reveal"><CodeBlock code={code.group} lang="html" /></div>
          <div class="rows reveal">
            <div class="row">
              <p>
                <b>Pay only when you use it</b>
                Groups live in their own entry, <code>@liquid-web/blur/melt</code>. Apart, the children are
                plain glass and the group draws nothing; without the script they stay plain glass too.
              </p>
              <p>
                <b>Merge distance</b>
                Children start to melt <code>--lb-merge</code> apart, <code>18px</code> by default. Set it
                on the group.
              </p>
            </div>
            <div class="row">
              <p>
                <b>Follows on its own</b>
                Springs, stretch and swell, inline styles and classes, size changes, CSS transitions and
                animations of the children. Anything else moving them: call <code>update()</code>.
              </p>
              <p>
                <b>Same material</b>
                Theme, transparency, depth and colors come from the same variables as any glass. The root
                gets <code>data-lb-melted</code> while it draws for the children.
              </p>
            </div>
          </div>
          <p class="prose reveal">
            <b><code>installGlassGroups(root?: Document): () =&gt; void</code></b><br />
            Turns every <code>.lb-group</code> into a group, including ones mounted later, and lets go of
            those that leave the page. For an element you manage yourself, there's
            <code>createGlassGroup()</code>:
          </p>
          <div class="reveal"><CodeBlock code={code.groupManual} lang="ts" /></div>
          <p class="prose reveal" style="margin-top: 40px">
            <b>Server rendering.</b> The entry is safe to import on the server, and
            <code>installGlassGroups()</code> does nothing there. Rendered without the script, the children
            are plain glass; close ones melt once it runs. With React, Vue or Svelte, install after hydration
            (in an effect), since the group adds its own elements to the root, and write
            <code>lb lb-group</code> in the markup, so a re-render that sets the class keeps <code>lb</code>.
          </p>
          <div class="reveal"><CodeBlock code={code.groupReact} lang="tsx" /></div>
        </section>

        <section class="doc" id="morph">
          <p class="lead reveal">
            <a class="anchor" href="#morph"><b>A control becomes a panel.</b></a> The same glass grows,
            moves and changes its corners, then shrinks back. Content arrives magnified and blurred,
            and settles sharp. It copies whatever the control looks like, so it works without the material
            too. Try the different layouts in the <a href="/lab">lab</a>.
          </p>
          <p class="prose reveal">
            A package of its own: <code>pnpm add @liquid-web/morph</code>. Lay out the content at its open
            position and size. Hide it with <code>visibility: hidden</code>,
            so it stays measurable. The source supplies the glass; the content does not need <code>lb</code>.
          </p>
          <div class="reveal"><CodeBlock code={code.morphLayout} lang="html" /></div>
          <div class="reveal"><CodeBlock code={code.morph} lang="ts" /></div>
          <div class="rows reveal">
            <div class="row">
              <p>
                <b>State and completion</b>
                <code>open()</code>, <code>close()</code> and <code>toggle()</code> can reverse a running
                animation and return a promise: <code>true</code> once it rests there, <code>false</code> if it
                turned around first. <code>{"{ instant: true }"}</code> swaps at once. <code>isOpen</code> is the
                requested state, <code>phase</code> whether it's there yet; <code>onStart(open)</code> and
                <code>onRest(open)</code> report the movement setting off and finishing.
                <code>initialOpen</code> starts it open. While open the glass follows the content's size and
                the window; <code>update()</code> covers any other move. <code>destroy()</code> removes the
                copies and restores the content.
              </p>
              <p>
                <b>Springs in each direction</b>
                Pass <code>{"spring: { open, close }"}</code>, each with any of <code>x</code>, <code>y</code>,
                <code>width</code>, <code>height</code> and <code>progress</code>; the rest stay default.
                <code>defaultMorphSprings</code> is exported from <code>@liquid-web/morph</code>.
              </p>
            </div>
          </div>
          <p class="prose reveal">
            Keep the content above the glass (<code>z-index: 2</code>) and leave its <code>transform</code>,
            <code>opacity</code>, <code>filter</code> and <code>clip-path</code> to the morph; a translation of
            its own, such as <code>translate: -50% -50%</code> for centering, is kept. Each corner of the panel
            keeps its own radius, so a sheet rounded on top stays square below. The glass copy joins the
            control's parent only while open or moving; if that parent clips, pass a <code>container</code>
            for it. Scrolling during the animation is not followed. Rotated or scaled ancestors are
            unsupported. Corner shapes interpolate where <code>corner-shape</code> is supported; otherwise
            corners stay round.
          </p>
          <p class="prose reveal">
            The source's <code>aria-expanded</code> is managed automatically. While the panel is out the
            source is unseen but stays focusable and readable. <code>dismiss: true</code> closes on Escape
            and on a press outside; focus and menu or dialog keyboard behavior belong to your app. With
            reduced motion, the panel and control swap immediately. Create the morph after mounting or
            hydration and destroy it on unmount; in React, a small hook does both:
          </p>
          <div class="reveal"><CodeBlock code={code.morphReact} lang="tsx" /></div>
        </section>

        <section class="doc" id="api">
          <p class="lead reveal">
            <a class="anchor" href="#api"><b>Presses and springs.</b></a> <code>@liquid-web/blur/press</code> turns
            presses on, <code>@liquid-web/core</code> exports the spring that powers them. Melt and morph
            are covered in their sections above.
          </p>
          <p class="prose reveal">
            <b><code>installPress(root?: Document): () =&gt; void</code></b><br />
            Installs press behaviors on a document and returns a cleanup. Installing twice returns the first
            cleanup. Looks through open shadow roots, works in iframes, and does nothing during server
            rendering.
          </p>
          <div class="reveal"><CodeBlock code={code.install} lang="ts" /></div>
          <p class="prose reveal" style="margin-top: 40px">
            <b><code>SpringAnimator</code></b><br />
            Animates several numbers at once with SwiftUI-style springs: a perceptual duration in seconds and a
            bounce from 0 to 1. Retargeting keeps the velocity, so reversing mid-flight stays smooth — which
            CSS transitions can't do.
          </p>
          <div class="reveal"><CodeBlock code={code.spring} lang="ts" /></div>
          <p class="prose reveal">Each channel can have a spring of its own:</p>
          <div class="reveal"><CodeBlock code={code.channels} lang="ts" /></div>
          <p class="prose reveal">
            <code>SpringParams</code> contains <code>duration</code>, <code>bounce</code> and optional
            <code>settle</code>. Duration is positive and measured in seconds; it is not a fixed completion
            deadline. Use bounce below <code>1</code> for a spring that settles. Settle changes bounce
            after the first reversal and defaults to the original bounce.
          </p>
        </section>

        <section class="doc" id="support">
          <p class="lead reveal">
            <a class="anchor" href="#support"><b>Browser support.</b></a> Anything with
            <code>backdrop-filter</code>, <code>color-mix()</code> and CSS <code>pow()</code>.
            Browsers without <code>@property</code> use fallbacks. Groups also need
            <code>clip-path: path()</code>, <code>mask</code> with an inline SVG <code>&lt;mask&gt;</code>, and Canvas 2D. JavaScript is ESM targeting ES2022.
          </p>
        </section>

        <section class="doc" id="limitations">
          <p class="lead reveal">
            <a class="anchor" href="#limitations"><b>Limitations.</b></a> What Liquid Blur doesn't do, or
            can't do around browser behavior, in one place.
          </p>
          <div class="rows reveal">
            <div class="row">
              <p>
                <b>Blur, not refraction</b>
                By design: blur, saturation, fill and shading are what every engine renders the same way.
              </p>
              <p>
                <b>Backdrop roots</b>
                Glass blurs only what's inside its backdrop root. An ancestor with <code>filter</code>,
                <code>opacity</code> below 1, <code>mask</code>, <code>clip-path</code>,
                <code>mix-blend-mode</code> or its own <code>backdrop-filter</code> cuts it off from
                everything behind that ancestor.
              </p>
            </div>
            <div class="row">
              <p>
                <b>Press behaviors</b>
                For single controls, not containers. Don't transition <code>scale</code> with swell or
                <code>transform</code> with stretch on the same element.
              </p>
              <p>
                <b>Groups and transforms</b>
                Scaling a group or an ancestor is fine, rotating isn't. Movement from outside the group
                isn't seen: call <code>update()</code>. Outlines use circular arcs, also for squircle children.
              </p>
            </div>
            <div class="row">
              <p>
                <b>No corner-shape clip around a group</b>
                An ancestor with <code>overflow: hidden</code> (or <code>clip</code>, or paint containment)
                and a <code>corner-shape</code> other than <code>round</code> makes Chromium show a blurred
                rectangle around melted glass. Give the shape to the ancestor's background layers and clip
                there, leaving the container unclipped. A plain <code>border-radius</code> clip is fine.
              </p>
              <p>
                <b>Morph</b>
                Measured on open and close, and on resize while open; other moves need <code>update()</code>.
                No rotated or scaled ancestors, and no content transform beyond a translation. Content hides with <code>visibility: hidden</code>, not <code>display: none</code>.
                Corners stay circular. Focus and keyboard behavior are yours.
              </p>
            </div>
            <div class="row">
              <p>
                <b>Older browsers</b>
                Without <code>@property</code> (Firefox &lt; 128) the glass renders through fallbacks:
                switches inherit and the press highlight doesn't fade. Corner shapes interpolate only where
                <code>corner-shape</code> is supported.
              </p>
            </div>
          </div>
        </section>

        <section class="doc" id="faq">
          <p class="lead reveal">
            <a class="anchor" href="#faq"><b>Questions? Answers.</b></a>
          </p>
          <div class="faq reveal">
            <details>
              <summary>Why no refraction?<Icon name="plus" /></summary>
              <div class="answer">
                Refraction on the web means SVG filters, which only one engine applies to a backdrop, and which
                cost a lot for every frame of scrolling. Liquid Blur keeps to what renders the same everywhere —
                so the glass you design is the glass everyone sees.
              </div>
            </details>
            <details>
              <summary>Does it need JavaScript?<Icon name="plus" /></summary>
              <div class="answer">
                No. The material is pure CSS. Optional scripts add press behaviors, glass groups and morphs.
                Without them, highlight and swell fall back to <code>:active</code>.
              </div>
            </details>
            <details>
              <summary>How do I use it with React, Vue or Svelte?<Icon name="plus" /></summary>
              <div class="answer">
                Use the classes as they are, and install the script once at the root. It returns its own cleanup.
                <CodeBlock code={code.react} lang="tsx" />
              </div>
            </details>
            <details>
              <summary>What does it cost?<Icon name="plus" /></summary>
              <div class="answer">
                A backdrop filter is work for the GPU, proportional to the area of glass on screen — so glass the
                size of a toolbar is cheap, and glass the size of the page is not. The script writes only
                transforms and two private properties per frame, and never reads layout while animating.
              </div>
            </details>
            <details>
              <summary>Is this Apple's Liquid Glass?<Icon name="plus" /></summary>
              <div class="answer">
                No. It's inspired by it and doesn't copy it: a calmer material, with no lensing, built for the
                web as it is.
              </div>
            </details>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</Base>

