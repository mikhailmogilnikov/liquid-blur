---
import Icon from "./Icon.astro";

/**
 * Morph test bench: one scenario per scene, each built to show a different way a morph can go
 * wrong. Slow motion and chaos (random interruptions) apply to all of them; the HUD measures
 * every run.
 */
const art =
  "radial-gradient(circle at 20% 25%, #ffd36e 0, transparent 40%), radial-gradient(circle at 80% 30%, #2f7bff 0, transparent 45%), radial-gradient(circle at 60% 85%, #1fd1a5 0, transparent 45%), radial-gradient(circle at 15% 90%, #ff4f81 0, transparent 40%), linear-gradient(135deg, #b5179e, #3a0ca3)";
const hue = (deg: number) => `background: ${art}; filter: hue-rotate(${deg}deg)`;
---

<section class="mlab" aria-label="Morph">
  <p class="mlab__lead">
    <b>Morph.</b> A control swells into a panel of the same glass. Each scene below pushes on a
    different weak spot; slow it down or let chaos interrupt it to see the seams.
  </p>

  <div class="mlab__bar">
    <label><input type="checkbox" data-slow /> Slow motion ×4</label>
    <label><input type="checkbox" data-chaos /> Chaos</label>
    <output class="mlab__hud" data-hud>Open anything to measure</output>
  </div>

  <!-- 1. The reference case: a corner button, the menu opening over it -->
  <section class="ms" data-scene="corner">
    <div class="ms__art" style={hue(60)}></div>
    <p class="ms__words" aria-hidden="true">Corner</p>
    <div class="ms__layer">
      <button class="src src--corner lb lb-interactive" type="button" aria-label="Create" aria-controls="m-corner" data-morph-source>
        <Icon name="plus" size={22} />
      </button>
    </div>
    <div class="panel panel--corner" id="m-corner" role="menu">
      <button type="button" role="menuitem" data-close><Icon name="arrow" size={18} />Share</button>
      <button type="button" role="menuitem" data-close><Icon name="heart" size={18} />Add to Favorites</button>
      <button type="button" role="menuitem" data-close><Icon name="copy" size={18} />Copy Link</button>
      <hr />
      <button type="button" role="menuitem" data-close><Icon name="plus" size={18} />New Tab</button>
      <button type="button" role="menuitem" data-close><Icon name="eye" size={18} />New Private Tab</button>
    </div>
    <p class="ms__hint"><b>Corner.</b> The reference: grows right and down from the button.</p>
  </section>

  <!-- 2. Opposite anchor: grows up and left, content scales from the other side -->
  <section class="ms" data-scene="fab">
    <div class="ms__art" style={hue(200)}></div>
    <p class="ms__words" aria-hidden="true">Upward</p>
    <div class="ms__layer">
      <button class="src src--fab lb lb-interactive" type="button" aria-label="Now playing" aria-controls="m-fab" data-morph-source>
        <Icon name="play" size={22} />
      </button>
    </div>
    <div class="panel panel--fab" id="m-fab" role="dialog" aria-label="Now playing">
      <div class="player">
        <div class="player__cover"></div>
        <div>
          <b>Night Swim</b>
          <span>Vera Lumen</span>
        </div>
      </div>
      <div class="player__track"><i></i></div>
      <div class="player__controls">
        <button type="button" aria-label="Back"><Icon name="back" size={22} /></button>
        <button type="button" aria-label="Pause" data-close><Icon name="pause" size={26} /></button>
        <button type="button" aria-label="Next"><Icon name="next" size={22} /></button>
      </div>
    </div>
    <p class="ms__hint"><b>Upward.</b> Anchored bottom-right: grows up and left.</p>
  </section>

  <!-- 3. A capsule with a text label that changes: corners from a capsule, the copy's label -->
  <section class="ms" data-scene="pill">
    <div class="ms__art" style={hue(110)}></div>
    <p class="ms__words" aria-hidden="true">Sort</p>
    <div class="ms__layer">
      <button class="src src--pill lb lb-interactive" type="button" aria-controls="m-pill" data-morph-source data-label>
        Newest
      </button>
    </div>
    <div class="panel panel--pill" id="m-pill" role="menu">
      <button type="button" role="menuitemradio" aria-checked="true" data-pick>Newest</button>
      <button type="button" role="menuitemradio" aria-checked="false" data-pick>Oldest</button>
      <button type="button" role="menuitemradio" aria-checked="false" data-pick>Most popular</button>
      <button type="button" role="menuitemradio" aria-checked="false" data-pick>A–Z</button>
    </div>
    <p class="ms__hint"><b>Capsule with a label.</b> Pick an option: the button comes back with the new label.</p>
  </section>

  <!-- 4. A circle into a field: circle → capsule, an input inside, focus -->
  <section class="ms" data-scene="search">
    <div class="ms__art" style={hue(300)}></div>
    <p class="ms__words" aria-hidden="true">Search</p>
    <div class="ms__layer">
      <button class="src src--search lb lb-interactive" type="button" aria-label="Search" aria-controls="m-search" data-morph-source>
        <Icon name="search" size={20} />
      </button>
    </div>
    <form class="panel panel--search" id="m-search" role="search" data-close-on-submit>
      <Icon name="search" size={18} />
      <input type="search" placeholder="Search" aria-label="Search" />
    </form>
    <p class="ms__hint"><b>Into a field.</b> A circle into a long capsule, anchored right; type, Enter or Esc.</p>
  </section>

  <!-- 5. Inside a glass group: the shape melts with its neighbour, the hidden control drops out -->
  <section class="ms" data-scene="group">
    <div class="ms__art" style={hue(20)}></div>
    <p class="ms__words" aria-hidden="true">Grouped</p>
    <div class="ms__layer">
      <div class="dock lb-group">
        <div class="dock__bar lb">
          <button type="button" aria-label="Back"><Icon name="back" size={20} /></button>
          <button type="button" aria-label="Play"><Icon name="play" size={20} /></button>
          <button type="button" aria-label="Next"><Icon name="next" size={20} /></button>
        </div>
        <button class="dock__more lb lb-interactive" type="button" aria-label="More" aria-controls="m-group" data-morph-source>
          <Icon name="more" size={20} />
        </button>
      </div>
    </div>
    <div class="panel panel--group" id="m-group" role="menu">
      <button type="button" role="menuitem" data-close><Icon name="heart" size={18} />Love</button>
      <button type="button" role="menuitem" data-close><Icon name="layers" size={18} />Add to Queue</button>
      <button type="button" role="menuitem" data-close><Icon name="copy" size={18} />Copy Link</button>
    </div>
    <p class="ms__hint"><b>In a group.</b> Melted to the bar: pours up out of the dock, parts from it, and back.</p>
  </section>

  <!-- 5b. Over its neighbours in a group: lifted out as glass of its own, the bar blurred under it -->
  <section class="ms" data-scene="group-over">
    <div class="ms__art" style={hue(330)}></div>
    <p class="ms__words" aria-hidden="true">Lifted</p>
    <div class="ms__layer">
      <div class="dock lb-group">
        <div class="dock__bar lb">
          <button type="button" aria-label="Back"><Icon name="back" size={20} /></button>
          <button type="button" aria-label="Play"><Icon name="play" size={20} /></button>
          <button type="button" aria-label="Next"><Icon name="next" size={20} /></button>
        </div>
        <button class="dock__more lb lb-interactive" type="button" aria-label="More" aria-controls="m-group-over" data-morph-source>
          <Icon name="more" size={20} />
        </button>
      </div>
    </div>
    <div class="panel panel--group-over" id="m-group-over" role="menu">
      <button type="button" role="menuitem" data-close><Icon name="heart" size={18} />Love</button>
      <button type="button" role="menuitem" data-close><Icon name="layers" size={18} />Add to Queue</button>
      <button type="button" role="menuitem" data-close><Icon name="copy" size={18} />Copy Link</button>
    </div>
    <p class="ms__hint"><b>Over the group.</b> Covers the bar: lifts out as its own glass, the bar blurred beneath.</p>
  </section>

  <!-- 5c. Squircles: corner-shape goes along with the radius, round into squircle too -->
  <section class="ms" data-scene="squircle">
    <div class="ms__art" style={hue(90)}></div>
    <p class="ms__words" aria-hidden="true">Squircle</p>
    <div class="ms__layer">
      <button class="src src--sq lb lb-interactive" type="button" aria-label="Apps" aria-controls="m-sq" data-morph-source>
        <Icon name="layers" size={22} />
      </button>
      <button class="src src--sq-round lb lb-interactive" type="button" aria-label="Create" aria-controls="m-sq-round" data-morph-source>
        <Icon name="plus" size={22} />
      </button>
    </div>
    <div class="panel panel--sq" id="m-sq" role="menu">
      <button type="button" role="menuitem" data-close><Icon name="frame" size={18} />Widgets</button>
      <button type="button" role="menuitem" data-close><Icon name="layers" size={18} />Stacks</button>
      <button type="button" role="menuitem" data-close><Icon name="copy" size={18} />Duplicate</button>
    </div>
    <div class="panel panel--sq-round" id="m-sq-round" role="menu">
      <button type="button" role="menuitem" data-close><Icon name="plus" size={18} />New Post</button>
      <button type="button" role="menuitem" data-close><Icon name="copy" size={18} />Drafts</button>
      <button type="button" role="menuitem" data-close><Icon name="motion" size={18} />Scheduled</button>
    </div>
    <p class="ms__hint"><b>Squircles.</b> Left: squircle into squircle. Right: round into squircle. Round where corner-shape isn't drawn.</p>
  </section>

  <!-- 6. Far away, no overlap: a long flight, clip and content far from their boxes -->
  <section class="ms" data-scene="far">
    <div class="ms__art" style={hue(160)}></div>
    <p class="ms__words" aria-hidden="true">Far</p>
    <div class="ms__layer">
      <button class="src src--far lb lb-clear lb-interactive" type="button" aria-label="Details" aria-controls="m-far" data-morph-source>
        <Icon name="heart" size={20} />
      </button>
    </div>
    <div class="panel panel--far" id="m-far" role="dialog" aria-label="Saved">
      <b>Saved to Favorites</b>
      <span>You'll find it in your library, on every device.</span>
      <button class="panel__action" type="button" data-close>Done</button>
    </div>
    <p class="ms__hint"><b>Far.</b> Clear glass, no overlap: flies across the scene.</p>
  </section>

  <!-- 7. Edge cases: barely bigger than the control; tall and tinted -->
  <section class="ms" data-scene="edges">
    <div class="ms__art" style={hue(240)}></div>
    <p class="ms__words" aria-hidden="true">Edges</p>
    <div class="ms__layer">
      <button class="src src--tiny lb lb-interactive" type="button" aria-controls="m-tiny" data-morph-source>
        Details
      </button>
      <button class="src src--tall lb lb-tinted lb-interactive" type="button" aria-label="Filters" aria-controls="m-tall" data-morph-source>
        <Icon name="layers" size={20} />
      </button>
    </div>
    <div class="panel panel--tiny" id="m-tiny" role="dialog" aria-label="Details">
      <b>Night Swim</b>
      <span>3:42 · 2026</span>
    </div>
    <div class="panel panel--tall panel--on-tint" id="m-tall" role="menu">
      <button type="button" role="menuitem" data-close>All</button>
      <button type="button" role="menuitem" data-close>Albums</button>
      <button type="button" role="menuitem" data-close>Artists</button>
      <button type="button" role="menuitem" data-close>Songs</button>
      <button type="button" role="menuitem" data-close>Playlists</button>
      <button type="button" role="menuitem" data-close>Podcasts</button>
      <button type="button" role="menuitem" data-close>Downloaded</button>
    </div>
    <p class="ms__hint"><b>Edges.</b> Left: barely bigger than the button. Right: tall, narrow, tinted.</p>
  </section>
</section>

<style>
  .mlab {
    display: grid;
    gap: 32px;
  }
  .mlab__lead { margin: 0; }

  .mlab__bar {
    position: sticky;
    top: 84px;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--wash);
    color: var(--ink);
  }
  .mlab__bar label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .mlab__hud {
    margin-left: auto;
    font: 12px/1.4 var(--mono);
    white-space: pre;
    color: var(--ink-2);
  }

  .ms {
    position: relative;
    height: 440px;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .ms__art {
    position: absolute;
    inset: -20%;
    background-size: 100% 100%;
  }
  .ms__words {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: clamp(48px, 10vw, 120px);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: rgb(255 255 255 / 0.85);
    line-height: 1;
  }
  .ms__layer {
    position: absolute;
    inset: 0;
  }
  .ms__hint {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 12px;
    margin: 0;
    text-align: center;
    color: rgb(255 255 255 / 0.85);
    font-size: 14px;
    pointer-events: none;
  }
  /* The scenes whose controls sit at the bottom carry the hint at the top */
  :is([data-scene="fab"], [data-scene="group"], [data-scene="group-over"], [data-scene="far"]) .ms__hint {
    top: 14px;
    bottom: auto;
  }

  button:not(.lb) { all: unset; cursor: pointer; display: grid; place-items: center; }
  button.lb {
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  /* Controls */
  .src { position: absolute; }
  .src--corner { left: 20px; top: 20px; width: 44px; height: 44px; border-radius: 22px; }
  .src--fab { right: 20px; bottom: 20px; width: 56px; height: 56px; border-radius: 28px; }
  .src--pill { left: 20px; top: 20px; height: 40px; padding: 0 18px; border-radius: 20px; font-weight: 600; }
  .src--search { right: 20px; top: 56px; width: 44px; height: 44px; border-radius: 22px; }
  .src--far { left: calc(50% - 24px); bottom: 24px; width: 48px; height: 48px; border-radius: 24px; }
  .src--tiny { left: 20px; top: 56px; height: 44px; padding: 0 20px; border-radius: 22px; font-weight: 600; }
  .src--tall { right: 20px; top: 56px; width: 48px; height: 48px; border-radius: 24px; }
  .src--sq { left: 20px; top: 56px; width: 52px; height: 52px; border-radius: 14px; }
  .src--sq-round { right: 20px; top: 56px; width: 52px; height: 52px; border-radius: 26px; }

  .dock {
    position: absolute;
    left: calc(50% - 120px);
    bottom: 32px;
    width: 240px;
    height: 56px;
  }
  .dock__bar {
    position: absolute;
    left: 0;
    top: 0;
    width: 176px;
    height: 56px;
    border-radius: 28px;
    display: flex;
    justify-content: space-around;
    align-items: center;
  }
  .dock__bar button { width: 48px; height: 48px; }
  .dock__more {
    position: absolute;
    left: 184px;
    top: 0;
    width: 56px;
    height: 56px;
    border-radius: 28px;
  }

  /*
   * Panels: laid out where they open, hidden until the script takes them. Never moved by
   * `transform`: that's the morph's while it runs.
   */
  .panel {
    position: absolute;
    z-index: 2;
    visibility: hidden;
    box-sizing: border-box;
    border-radius: 28px;
    color: var(--ink);
  }
  .panel--on-tint { color: var(--lb-tint-text); }
  .panel[role="menu"] {
    display: grid;
    align-content: start;
    padding: 8px;
  }
  .panel[role="menu"] button {
    justify-content: start;
    grid-auto-flow: column;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 14px;
  }
  .panel[role="menu"] button:hover { background: rgb(127 127 127 / 0.14); }
  .panel hr {
    width: calc(100% - 24px);
    margin: 4px 12px;
    border: 0;
    border-top: 1px solid rgb(127 127 127 / 0.25);
  }
  .panel[role="dialog"] {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 18px 20px;
  }
  .panel[role="dialog"] span { color: var(--ink-2); font-size: 14px; }
  .panel .panel__action {
    justify-self: end;
    margin-top: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--lb-tint);
    color: var(--lb-tint-text);
    font-weight: 600;
  }

  .panel--corner { left: 20px; top: 20px; width: 240px; }
  .panel--fab { right: 20px; bottom: 20px; width: 280px; }
  .panel--pill { left: 20px; top: 20px; width: 200px; }
  .panel[role="menu"].panel--pill button[aria-checked="true"] { font-weight: 600; }
  .panel--search {
    right: 20px;
    top: 56px;
    width: min(360px, calc(100% - 40px));
    height: 44px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
  }
  .panel--search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    outline: none;
  }
  /*
   * Above the dock, not over it: the group's glass is one surface behind all its children, so a
   * panel over the bar would show the bar's buttons through it. 28px apart, past the 24px merge:
   * it pours out of the dock on the way and stands on its own at rest.
   */
  .panel--group { right: calc(50% - 120px); bottom: 116px; width: 220px; }
  /* Over the dock, from the button's corner: the morph lifts out of the group for it */
  .panel--group-over { right: calc(50% - 120px); bottom: 32px; width: 220px; }
  .panel--far { left: calc(50% - 140px); top: 56px; width: 280px; }
  .panel--tiny { left: 20px; top: 56px; width: 150px; padding: 12px 20px; border-radius: 22px; }
  .panel--tall { right: 20px; top: 56px; width: 180px; }
  .panel--sq { left: 20px; top: 56px; width: 200px; border-radius: 24px; }
  .panel--sq-round { right: 20px; top: 56px; width: 200px; border-radius: 24px; }

  /*
   * Continuous corners where the browser draws them: a squircle bends later than an arc, so radii
   * grow by ~1.5x to keep the corner's visual size. The circle stays round; the morph carries
   * corner-shape from the control's to the panel's.
   */
  @supports (corner-shape: squircle) {
    .src--sq { border-radius: 20px; corner-shape: squircle; }
    .panel--sq,
    .panel--sq-round { border-radius: 36px; corner-shape: squircle; }
  }

  .player {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .player__cover {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: linear-gradient(135deg, #ff4f81, #2f7bff);
  }
  .player span { display: block; color: var(--ink-2); font-size: 14px; }
  .player__track {
    height: 4px;
    margin: 16px 0 6px;
    border-radius: 2px;
    background: rgb(127 127 127 / 0.25);
  }
  .player__track i {
    display: block;
    width: 38%;
    height: 100%;
    border-radius: 2px;
    background: currentColor;
  }
  .player__controls {
    display: flex;
    justify-content: space-around;
  }
  .player__controls button { width: 48px; height: 48px; }
</style>

<script>
  import { createMorph, defaultMorphSprings, type Morph, type MorphSprings } from "liquid-blur/morph";

  type Entry = { scene: HTMLElement; source: HTMLElement; content: HTMLElement; morph: Morph | null };

  const entries: Entry[] = [...document.querySelectorAll<HTMLElement>("[data-morph-source]")].map((source) => ({
    scene: source.closest<HTMLElement>("[data-scene]")!,
    source,
    content: document.getElementById(source.getAttribute("aria-controls")!)!,
    morph: null,
  }));

  // HUD: main-thread time per frame (from the frame's start to a task posted in it: springs,
  // style, layout, the group's redraw and paint recording) and the gaps between frames
  const hud = document.querySelector<HTMLOutputElement>("[data-hud]")!;
  let probe: { name: string; busy: number[]; gaps: number[]; last: number; frame: number } | null = null;
  const pong = new MessageChannel();
  let frameStart = 0;
  pong.port1.onmessage = () => probe?.busy.push(performance.now() - frameStart);
  const sample = (now: number) => {
    if (!probe) return;
    if (probe.last) probe.gaps.push(now - probe.last);
    probe.last = now;
    frameStart = performance.now();
    pong.port2.postMessage(0);
    probe.frame = requestAnimationFrame(sample);
  };
  const measure = (name: string) => {
    if (probe) cancelAnimationFrame(probe.frame);
    probe = { name, busy: [], gaps: [], last: 0, frame: requestAnimationFrame(sample) };
  };
  const report = (open: boolean) => {
    if (!probe) return;
    cancelAnimationFrame(probe.frame);
    const { name, busy, gaps } = probe;
    probe = null;
    if (!gaps.length) return;
    const sorted = [...gaps].sort((a, b) => a - b);
    const refresh = sorted[Math.floor(sorted.length / 2)];
    const dropped = gaps.filter((g) => g > refresh * 1.5).length;
    const avg = busy.reduce((a, b) => a + b, 0) / busy.length;
    hud.value =
      `${name} ${open ? "open" : "close"} · ${gaps.length} frames @ ${(1000 / refresh).toFixed(0)}Hz\n` +
      `main avg ${avg.toFixed(1)}ms max ${Math.max(...busy).toFixed(1)}ms · dropped ${dropped}`;
  };

  // Focus follows: into the panel once open, back to the control once it's there again
  const rested = (entry: Entry, open: boolean) => {
    if (open) {
      entry.content.querySelector<HTMLElement>("input, button")?.focus({ preventScroll: true });
    } else if (document.activeElement === document.body || entry.content.contains(document.activeElement)) {
      entry.source.focus({ preventScroll: true });
    }
    report(open);
  };

  // Slow motion stretches every spring; changing it rebuilds the morphs
  const slowed = (factor: number): { open: MorphSprings; close: MorphSprings } => {
    const scale = (set: MorphSprings) =>
      Object.fromEntries(
        Object.entries(set).map(([key, s]) => [key, { ...s, duration: s.duration * factor }]),
      ) as MorphSprings;
    return { open: scale(defaultMorphSprings.open), close: scale(defaultMorphSprings.close) };
  };
  const build = (factor: number) => {
    for (const entry of entries) {
      entry.morph?.destroy();
      entry.morph = createMorph({
        source: entry.source,
        content: entry.content,
        spring: slowed(factor),
        onRest: (open) => rested(entry, open),
      });
    }
  };
  build(1);
  document.querySelector<HTMLInputElement>("[data-slow]")!.addEventListener("change", (e) => {
    build((e.target as HTMLInputElement).checked ? 4 : 1);
  });

  const toggle = (entry: Entry) => {
    measure(entry.scene.dataset.scene!);
    entry.morph?.toggle();
  };
  const close = (entry: Entry) => {
    if (!entry.morph?.isOpen) return;
    measure(entry.scene.dataset.scene!);
    entry.morph.close();
  };

  for (const entry of entries) {
    entry.source.addEventListener("click", () => toggle(entry));
    entry.content.addEventListener("click", (e) => {
      const target = e.target as Element;
      // A sort option relabels the control: the copy has to come back with the new label
      const pick = target.closest<HTMLElement>("[data-pick]");
      if (pick) {
        for (const option of entry.content.querySelectorAll("[data-pick]")) {
          option.setAttribute("aria-checked", String(option === pick));
        }
        entry.source.textContent = pick.textContent!.trim();
      }
      if (pick || target.closest("[data-close]")) close(entry);
    });
    entry.content.addEventListener("submit", (e) => {
      e.preventDefault();
      close(entry);
    });
  }

  // A press anywhere else in the scene closes what's open there
  for (const scene of new Set(entries.map((e) => e.scene))) {
    scene.addEventListener("pointerdown", (e) => {
      const target = e.target as Node;
      for (const entry of entries) {
        if (entry.scene !== scene || !entry.morph?.isOpen) continue;
        if (entry.content.contains(target) || entry.source.contains(target)) continue;
        close(entry);
      }
    });
  }
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    for (const entry of entries) close(entry);
  });

  // Chaos: something toggles every so often, often mid-flight, to catch what interrupting breaks
  let chaos = 0;
  const strike = () => {
    const entry = entries[Math.floor(Math.random() * entries.length)];
    toggle(entry);
    chaos = window.setTimeout(strike, 120 + Math.random() * 600);
  };
  document.querySelector<HTMLInputElement>("[data-chaos]")!.addEventListener("change", (e) => {
    window.clearTimeout(chaos);
    if ((e.target as HTMLInputElement).checked) strike();
  });
</script>
