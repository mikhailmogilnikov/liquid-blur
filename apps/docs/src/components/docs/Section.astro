---
/** A section of a package's page, under a heading of its own; the page's contents list these */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section class="doc reveal" id={id}>
  <h2 class="doc__title"><a class="anchor" href={`#${id}`}>{title}</a></h2>
  <slot />
</section>
