---
import { Code } from "astro:components";
import Icon from "./Icon.astro";

interface Props {
  code: string;
  lang?: "ts" | "js" | "html" | "css" | "tsx" | "bash";
  label?: string;
}

const { code, lang = "ts", label } = Astro.props;
---

<div class="code">
  {label && <div class="code__bar">{label}</div>}
  <Code code={code.trim()} lang={lang} themes={{ light: "vitesse-light", dark: "vitesse-dark" }} defaultColor={false} />
  <button class="code__copy" type="button" data-copy aria-label="Copy code">
    <Icon name="copy" class="is-idle" />
    <Icon name="check" class="is-done" />
  </button>
</div>
