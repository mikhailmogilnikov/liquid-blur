---
import Icon from "./Icon.astro";

/**
 * One of Indicator's examples, live:
 *   - menu: a glass menu whose highlight follows the pointer, across a separator, past a disabled item
 *   - tabs: iOS-style tabs, a thumb resting on the chosen one, dragged across by a press
 */
interface Props {
  kind: "menu" | "tabs";
  /** As a library's card on the landing: the card's size and corners, and room for a hint (the slot) */
  card?: boolean;
}

const { kind, card = false } = Astro.props;
const tabs = [
  ["Overview", "Plays, saves and listeners this week."],
  ["Releases", "Three albums and a single, newest first."],
  ["Audience", "Where your listeners are, and when."],
] as const;
---

<div
  class:list={["ix", `ix--${kind}`, { "ix--card": card }]}
  data-ix={kind}
  data-hints={card ? "" : undefined}
>
  <div class="bd bd-aurora" data-silk="indicator"></div>

  {
    kind === "menu" && (
      <div class="ix__menu lb" role="menu" aria-label="Album" data-ix-container>
        <span class="ix__highlight" aria-hidden="true" data-ix-indicator />
        <button type="button" role="menuitem">
          <Icon name="plus" size={18} />
          Add to Library
        </button>
        <button type="button" role="menuitem">
          <Icon name="heart" size={18} />
          Love
        </button>
        <button type="button" role="menuitem">
          <Icon name="arrow" size={18} />
          Share Album
        </button>
        <hr />
        <button type="button" role="menuitem">
          <Icon name="copy" size={18} />
          Copy Link
        </button>
        <button type="button" role="menuitem" aria-disabled="true">
          <Icon name="eye" size={18} />
          Show in Store
        </button>
      </div>
    )
  }

  {
    kind === "tabs" && (
      <div class="ix__card lb">
        <div class="ix__tabs" role="tablist" aria-label="Artist" data-ix-container>
          <span class="ix__thumb" aria-hidden="true" data-ix-indicator />
          {tabs.map(([label, text], i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-text={text}>
              {label}
            </button>
          ))}
        </div>
        <p class="ix__text" role="tabpanel" data-ix-panel>
          {tabs[0][1]}
        </p>
      </div>
    )
  }
  <slot />
</div>

<style>
  .ix {
    position: relative;
    height: 340px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    background: var(--wash);
    isolation: isolate;
  }
  .ix--tabs { height: 240px; }
  .ix--card {
    height: var(--mdemo-height);
    border-radius: var(--radius);
  }

  /* The container is positioned, and a stacking context of its own (glass is), so the indicator at
     z-index -1 is drawn over its surface and under its items */
  .ix__menu {
    position: relative;
    width: 248px;
    display: grid;
    padding: 8px;
    border-radius: 32px;
    color: var(--ink);
    /* A press drags across the items: no page scrolling under a finger, no text selection under a mouse */
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .ix__menu button {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 18px 0 16px;
    border-radius: 999px;
    background: none;
    color: inherit;
    font-size: 15px;
    text-align: left;
  }
  .ix__menu button[aria-disabled="true"] { opacity: 0.4; cursor: default; }
  .ix__menu button:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  .ix__menu hr {
    width: calc(100% - 24px);
    margin: 4px 12px;
    border: 0;
    border-top: 1px solid rgb(127 127 127 / 0.25);
  }
  /* Faint in the light, where dark ink shows a lot; deeper while pressed (`data-pressed`) */
  .ix__highlight {
    position: absolute;
    z-index: -1;
    background: color-mix(in srgb, currentColor calc(6% + var(--lb-dark) * 6%), transparent);
  }
  .ix__highlight[data-pressed] {
    background: color-mix(in srgb, currentColor calc(11% + var(--lb-dark) * 7%), transparent);
  }

  .ix__card {
    width: min(360px, calc(100% - 32px));
    padding: 12px 12px 20px;
    border-radius: 24px;
    color: var(--ink);
  }
  /* A track the thumb slides in, as iOS draws its segmented tabs; a stacking context for the thumb */
  .ix__tabs {
    position: relative;
    isolation: isolate;
    display: flex;
    padding: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 9%, transparent);
    /* A press drags the thumb across: no page scrolling, no text selection */
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .ix__tabs button {
    flex: 1;
    height: 32px;
    padding: 0 10px;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s;
  }
  .ix__tabs button[aria-selected="true"] { color: var(--ink); }
  .ix__tabs button:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  /* On glass, as iOS has it: white in the light, a light veil in the dark (the material's own theme) */
  .ix__thumb {
    position: absolute;
    z-index: -1;
    background: color-mix(in srgb, #fff calc(100% - var(--lb-dark) * 78%), transparent);
    box-shadow: 0 1px 3px rgb(0 0 0 / calc(0.12 - var(--lb-dark) * 0.12)), 0 0 0 0.5px rgb(0 0 0 / 0.04);
  }
  .ix__text {
    margin: 16px 12px 0;
    color: var(--ink-2);
    font-size: 14px;
  }
</style>

<script>
  import { createIndicator } from "@fluidkit/core";

  for (const scene of document.querySelectorAll<HTMLElement>("[data-ix]:not([data-ix-ready])")) {
    scene.dataset.ixReady = "";
    const container = scene.querySelector<HTMLElement>("[data-ix-container]")!;

    if (scene.dataset.ix === "menu") {
      // Hover for a mouse, a press dragged across for a finger: the defaults
      createIndicator({ container, indicator: scene.querySelector<HTMLElement>("[data-ix-indicator]")! });
      continue;
    }

    // Tabs: the thumb rests on the chosen one; pressed and dragged across, it follows, and the
    // tab it's released on is chosen
    const tabs = [...container.querySelectorAll<HTMLButtonElement>("[role='tab']")];
    const panel = scene.querySelector<HTMLElement>("[data-ix-panel]")!;
    const thumb = createIndicator({
      container,
      indicator: scene.querySelector<HTMLElement>("[data-ix-indicator]")!,
      trigger: "press",
      rest: tabs.find((tab) => tab.getAttribute("aria-selected") === "true") ?? null,
      // It shows the choice; keyboard focus keeps its own ring
      focus: false,
    });
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        for (const t of tabs) t.setAttribute("aria-selected", String(t === tab));
        panel.textContent = tab.dataset.text ?? "";
        thumb.rest = tab;
      });
    }
  }
</script>
