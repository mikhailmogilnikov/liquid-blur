---
import Icon from "./Icon.astro";

/**
 * One of Lift's examples, live:
 *   - photos: a grid of photos, each lifted with a menu under it (or over it)
 *   - message: chat bubbles, lifted with a row of reactions and a few actions
 *   - icon: app icons, lifted with quick actions
 */
interface Props {
  kind: "photos" | "message" | "icon";
  /** As a library's card on the landing: the card's size and corners, and room for a hint (the slot) */
  card?: boolean;
}

const { kind, card = false } = Astro.props;
const photos = ["#ff9a9e, #fad0c4", "#a18cd1, #fbc2eb", "#84fab0, #8fd3f4", "#fccb90, #d57eeb", "#e0c3fc, #8ec5fc", "#f093fb, #f5576c"];
const messages = [
  ["in", "Are we still on for Friday?"],
  ["out", "Yes! 8pm at the usual place"],
  ["in", "Perfect, I'll book a table"],
] as const;
const reactions = ["❤️", "👍", "😂", "😮", "😢", "🔥"];
const apps = [
  ["Notes", "#ffd60a, #ff9f0a", "N"],
  ["Music", "#ff375f, #ff2d55", "♪"],
  ["Maps", "#34c759, #30b0c7", "M"],
  ["Photos", "#ff9f0a, #af52de", "P"],
  ["Mail", "#0a84ff, #5ac8fa", "@"],
  ["Weather", "#5e5ce6, #0a84ff", "☀"],
  ["Camera", "#3a3a3c, #636366", "●"],
  ["Clock", "#1c1c1e, #48484a", "◷"],
] as const;
---

<div class:list={["lx", `lx--${kind}`, { "lx--card": card }]} data-lx={kind} data-hints={card ? "" : undefined}>
  <div class="bd bd-aurora" data-silk="lift"></div>

  {
    kind === "photos" && (
      <>
        <div class="lx__grid">
          {photos.map((colors, i) => (
            <div
              class="lx__photo"
              tabindex="0"
              role="img"
              aria-label={`Photo ${i + 1}`}
              style={`background: linear-gradient(135deg, ${colors})`}
              data-lx-target
            />
          ))}
        </div>
        <div class="lx__menu lb" role="menu" aria-label="Photo" hidden data-lx-menu>
          <span class="lx__highlight" aria-hidden="true" data-lx-highlight />
          <button type="button" role="menuitem" data-lx-item>
            Copy
            <Icon name="copy" size={17} />
          </button>
          <button type="button" role="menuitem" data-lx-item>
            Share
            <Icon name="arrow" size={17} />
          </button>
          <button type="button" role="menuitem" data-lx-item>
            Favorite
            <Icon name="heart" size={17} />
          </button>
          <hr />
          <button type="button" role="menuitem" class="lx__danger" data-lx-item>
            Delete
            <Icon name="plus" size={17} />
          </button>
        </div>
      </>
    )
  }

  {
    kind === "message" && (
      <>
        <div class="lx__chat lb">
          {messages.map(([side, text]) => (
            <div class:list={["lx__bubble", `lx__bubble--${side}`]} tabindex="0" data-lx-target>
              {text}
              <span class="lx__reaction" aria-hidden="true" data-lx-reaction />
            </div>
          ))}
        </div>
        <div class="lx__stack" role="menu" aria-label="Message" hidden data-lx-menu>
          <div class="lx__reactions lb" role="group" aria-label="React">
            {reactions.map((r) => (
              <button type="button" role="menuitem" aria-label={`React ${r}`} data-reaction={r}>
                {r}
              </button>
            ))}
          </div>
          <div class="lx__menu lb">
            <span class="lx__highlight" aria-hidden="true" data-lx-highlight />
            <button type="button" role="menuitem" data-lx-item>
              Reply
              <Icon name="back" size={17} />
            </button>
            <button type="button" role="menuitem" data-lx-item>
              Copy
              <Icon name="copy" size={17} />
            </button>
            <button type="button" role="menuitem" class="lx__danger" data-lx-item>
              Delete
              <Icon name="plus" size={17} />
            </button>
          </div>
        </div>
      </>
    )
  }

  {
    kind === "icon" && (
      <>
        <div class="lx__apps">
          {apps.map(([name, colors, glyph]) => (
            <div class="lx__app">
              <div
                class="lx__icon"
                tabindex="0"
                role="img"
                aria-label={name}
                style={`background: linear-gradient(160deg, ${colors})`}
                data-lx-target
                data-name={name}
              >
                {glyph}
              </div>
              <span>{name}</span>
            </div>
          ))}
        </div>
        <div class="lx__menu lb" role="menu" aria-label="App" hidden data-lx-menu>
          <span class="lx__highlight" aria-hidden="true" data-lx-highlight />
          <button type="button" role="menuitem" data-lx-item>
            New Item
            <Icon name="plus" size={17} />
          </button>
          <button type="button" role="menuitem" data-lx-item>
            Search
            <Icon name="search" size={17} />
          </button>
          <hr />
          <button type="button" role="menuitem" data-lx-item>
            Edit Home Screen
            <Icon name="layers" size={17} />
          </button>
          <button type="button" role="menuitem" class="lx__danger" data-lx-item>
            Remove App
            <Icon name="plus" size={17} />
          </button>
        </div>
      </>
    )
  }
  <slot />
</div>

<style>
  .lx {
    position: relative;
    height: 400px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    border-radius: 20px;
    isolation: isolate;
  }
  .lx--card {
    height: var(--mdemo-height);
    border-radius: var(--radius);
  }
  /* Over the backdrop, which is positioned */
  .lx > :not(.bd, .hint) { position: relative; }
  /* Held, it gives a little before it lifts (`data-lifting`) */
  [data-lx-target] {
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
    transition: scale 0.4s var(--settle);
  }
  [data-lx-target][data-lifting] { scale: 0.96; }
  [data-lx-target]:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .lx__grid {
    width: min(360px, calc(100% - 32px));
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .lx__photo { aspect-ratio: 1; border-radius: 14px; }
  /* On the landing: smaller, room for its hint under it */
  .lx--card .lx__grid { width: min(300px, calc(100% - 32px)); margin-bottom: 72px; }

  .lx__chat {
    width: min(360px, calc(100% - 32px));
    display: grid;
    gap: 10px;
    padding: 16px;
    border-radius: 26px;
  }
  .lx__bubble {
    position: relative;
    max-width: 78%;
    padding: 9px 14px;
    border-radius: 20px;
    font-size: 15px;
    line-height: 1.3;
  }
  .lx__bubble--in {
    justify-self: start;
    background: color-mix(in srgb, var(--ink) 9%, var(--ground));
    color: var(--ink);
  }
  .lx__bubble--out {
    justify-self: end;
    background: #0a84ff;
    color: #fff;
  }
  .lx__reaction {
    position: absolute;
    top: -12px;
    right: -6px;
    font-size: 16px;
    line-height: 1;
  }
  .lx__bubble--out .lx__reaction { right: auto; left: -6px; }

  .lx__apps {
    width: min(340px, calc(100% - 32px));
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px 10px;
  }
  .lx__app {
    display: grid;
    justify-items: center;
    gap: 6px;
    color: #fff;
    font-size: 12px;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.35);
  }
  .lx__icon {
    width: 62px;
    height: 62px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    color: #fff;
    font-size: 28px;
    font-weight: 700;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.15);
  }

  /* Hidden until it's lifted beside something: `hidden`, which a display of its own would undo */
  [data-lx-menu][hidden] { display: none; }
  /* The menu: glass, its rows' highlight an indicator */
  .lx__menu {
    width: 230px;
    display: grid;
    padding: 6px;
    border-radius: 24px;
    color: var(--ink);
  }
  .lx__menu button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    background: none;
    color: inherit;
    font-size: 15px;
    text-align: left;
  }
  .lx__menu button:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  .lx__menu .lx__danger { color: #ff3b30; }
  .lx__menu .lx__danger svg { rotate: 45deg; }
  .lx__menu hr { width: calc(100% - 24px); margin: 3px 12px; border: 0; border-top: 1px solid rgb(127 127 127 / 0.25); }
  .lx__highlight {
    position: absolute;
    z-index: -1;
    background: color-mix(in srgb, currentColor calc(6% + var(--lb-dark) * 6%), transparent);
  }
  .lx__highlight[data-pressed] {
    background: color-mix(in srgb, currentColor calc(11% + var(--lb-dark) * 7%), transparent);
  }

  /* A message's: reactions over its actions */
  .lx__stack { display: grid; gap: 8px; width: 270px; }
  .lx__reactions {
    display: flex;
    justify-content: space-between;
    padding: 6px;
    border-radius: 999px;
  }
  .lx__reactions button {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: none;
    font-size: 22px;
    transition: scale 0.25s var(--settle), background-color 0.15s;
  }
  .lx__reactions button:is(:hover, [data-highlighted]) {
    scale: 1.2;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  .lx__stack .lx__menu { justify-self: start; }
</style>

<script>
  import { createIndicator, createLift } from "@fluidkit/core";

  for (const scene of document.querySelectorAll<HTMLElement>("[data-lx]:not([data-lx-ready])")) {
    scene.dataset.lxReady = "";
    const menu = scene.querySelector<HTMLElement>("[data-lx-menu]")!;
    // The rows' highlight: under a mouse by itself, under the finger that lifted the menu by hand
    const list = menu.matches(".lx__menu") ? menu : menu.querySelector<HTMLElement>(".lx__menu")!;
    const highlight = createIndicator({
      container: list,
      indicator: list.querySelector<HTMLElement>("[data-lx-highlight]")!,
      items: "[data-lx-item]",
    });

    for (const target of scene.querySelectorAll<HTMLElement>("[data-lx-target]")) {
      createLift({
        element: target,
        menu,
        onHighlight: (item) => highlight.to(item && list.contains(item) ? item : null),
        onSelect: (item) => {
          // A reaction lands on the message
          const reaction = item.dataset.reaction;
          const badge = target.querySelector<HTMLElement>("[data-lx-reaction]");
          if (reaction && badge) badge.textContent = badge.textContent === reaction ? "" : reaction;
        },
        onClose: () => highlight.to(null, { instant: true }),
      });
    }
  }
</script>
