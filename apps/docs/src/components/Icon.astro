} as const;

interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
  /** The same in two states of a morph: it flies from one to the other (`data-lw-match`) */
  match?: string;
}

const { name, size = 18, class: className, match } = Astro.props;
---

<svg
  class={className}
  data-lw-match={match}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
