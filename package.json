{
  "name": "liquid-web",
  "private": true,
  "license": "MIT",
  "author": "Mikhail Mogilnikov",
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "dev": "vp run -r --cache build && vp run -r --parallel dev",
    "build": "vp run -r --cache build",
    "check-types": "vp run -r --cache build && vp run -r --cache check-types",
    "test": "vp run -r --cache test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp fmt --check && vp lint && pnpm check-types && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.1.0"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@12.9.1"
}
